{
  "$defs": {
    "PaperRecord": {
      "additionalProperties": true,
      "description": "One work: a ``schema:ScholarlyArticle`` node.\n\nA paper IS a research output, so this is a specialization of\n:class:`~.ResearchOutput`: it inherits the shared core (``name``,\n``type``, ``description``, ``url``, plus ``@id`` / ``@type``) and adds the\nbibliographic, authorship and access fields a scholarly work needs.\n\nPapers live in ``sources/papers.jsonld``, not in the profile's\n``researchOutputs`` list; the shared lineage is about the schema, not the\nstorage location.\n\n``type`` here is the OpenAlex work type (``article``, ``review``, ...),\nwhich narrows the base class's output-kind meaning; it is optional because\nnot every source reports one.\n\nEvery *build* field (``status``, ``download_attempts``, ``contaminated``,\n``identity_verified``, ...) lives in ``.build/<slug>/meta/build_state.json``\ninstead. Publishing a profile publishes the bibliographic record, not the\nbuild's dirty laundry.",
      "properties": {
        "@context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "@Context"
        },
        "@id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "@Id"
        },
        "@type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "ScholarlyArticle",
          "title": "@Type"
        },
        "abstract": {
