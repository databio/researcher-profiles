          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Profile Url"
    },
    "provenance": {
      "title": "Provenance",
      "type": "string"
    },
    "rid": {
      "title": "Rid",
      "type": "string"
    },
    "sdk_version": {
      "title": "Sdk Version",
      "type": "string"
    },
    "slug": {
      "title": "Slug",
      "type": "string"
    },
    "summary": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Summary"
    },
    "text": {
      "title": "Text",
      "type": "string"
    },
    "text_chars": {
