{
  "name": "@researcher-profiles/browser",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Researcher Profile Browser and Conformance Validator: a serverless SPA for browsing and validating published researcher profiles.",
  "scripts": {
    "dev": "node scripts/copy-skills.mjs && vite",
    "build": "node scripts/copy-skills.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:skills": "node scripts/copy-skills.mjs",
    "fetch:model": "node scripts/fetch-model.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "typescript": "~5.9",
    "vite": "^8",
    "vite-plugin-static-copy": "^4",
    "vitest": "^4"
  }
}
